# =============================================================================
# 云端：执行 SQL / sync_meta_cn 等用的本地配置模板
#
# 使用步骤：
#   1. 复制本文件为「.env.cloud」（与 .env 同级，与项目根目录一致）
#   2. 在 .env.cloud 里填写下面各项；私钥只填「本机文件路径」，勿粘贴私钥正文
#   3. .env.cloud 已被 .gitignore 忽略，不要提交
#
# 更推荐：SSH 用 ~/.ssh/config 管理 Host，此处只记别名与远端目录即可。
# =============================================================================

# --- SSH：私钥文件在本机的路径（示例：~/.ssh/id_ed25519），不要把密钥内容写进文件 ---
CLOUD_SSH_HOST=aierp-cloud
CLOUD_SSH_HOSTNAME=在此填写服务器 IP 或域名
CLOUD_SSH_USER=root
CLOUD_SSH_IDENTITY_FILE=~/.ssh/id_ed25519
CLOUD_SSH_REMOTE_DIR=/home/AIERP

# --- 可选：远端直接连 PostgreSQL 时用（多数情况在 SSH 里执行 psql 即可，可留空）---
# CLOUD_PGHOST=
# CLOUD_PGPORT=5432
# CLOUD_PGUSER=nicjiang
# CLOUD_PGDATABASE=aierp
# 数据库密码更推荐写在用户目录 ~/.pgpass，不要写在此文件

# =============================================================================
# 将下面整块复制到本机 ~/.ssh/config（没有则新建），把占位符改成你的值。
# 配置好后，终端里可执行：ssh aierp-cloud
# =============================================================================
#
# Host aierp-cloud
#     HostName 在此填 CLOUD_SSH_HOSTNAME
#     User root
#     IdentityFile ~/.ssh/id_ed25519
#
# =============================================================================
